generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id           String     @id @default(cuid())
  email        String     @unique
  firstName    String
  customFields Json?
  status       LeadStatus @default(ACTIVE)
  score        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sequenceStates SequenceState[]
  events         Event[]
  segments       LeadSegment[]
}

enum LeadStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

model Sequence {
  id               String      @id @default(cuid())
  name             String
  trigger          TriggerType
  isActive         Boolean     @default(false)
  trackOpens       Boolean     @default(true)
  trackClicks      Boolean     @default(true)
  sendTime         String?     // e.g. "09:00" or null for immediate
  scheduledStartAt DateTime?   // Optionales Startdatum für die Sequenz
  color            String?     // Farbe für UI (z.B. "#8b5cf6")
  folderId         String?
  folder           SequenceFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  steps  SequenceStep[]
  states SequenceState[]
  forms  SignupForm[]

  @@index([folderId])
}

model SequenceFolder {
  id        String     @id @default(cuid())
  name      String
  color     String?
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  sequences Sequence[]
}

enum TriggerType {
  ON_IMPORT
  MANUAL
  API_WEBHOOK
}

model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  type       StepType

  // E-Mail Content
  subject String?
  content Json?

  // Delay
  delayValue Int?
  delayUnit  String?

  // Tag
  tagAction String?  // "add" oder "remove"
  tagValue  String?  // Tag-Name

  // Segment
  targetSegmentId String?

  // Condition
  conditionType  String?  // "HAS_TAG", "NOT_HAS_TAG", "IN_SEGMENT", "NOT_IN_SEGMENT", "OPENED_EMAIL", "NOT_OPENED_EMAIL", "CLICKED_EMAIL"
  conditionValue String?  // Tag-Name, Segment-ID, oder Step-ID
  falseSteps     Json?    // Array von Steps die bei FALSE ausgeführt werden

  // A/B Testing
  variants Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sequenceId])
}

enum StepType {
  EMAIL
  DELAY
  TAG
  SEGMENT
  CONDITION
}

model SequenceState {
  id               String              @id @default(cuid())
  leadId           String
  lead             Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequenceId       String
  sequence         Sequence            @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  currentStepIndex Int                 @default(0)
  status           SequenceStateStatus @default(ACTIVE)
  nextRunAt        DateTime?
  startedAt        DateTime            @default(now())
  completedAt      DateTime?

  @@unique([leadId, sequenceId])
  @@index([sequenceId])
  @@index([nextRunAt])
}

enum SequenceStateStatus {
  ACTIVE
  COMPLETED
  STOPPED_BOUNCE
  UNSUBSCRIBED
}

model Event {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      EventType
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([leadId])
  @@index([createdAt])
}

enum EventType {
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_BOUNCED
  UNSUBSCRIBED
  TAG_UPDATED
  SEGMENT_ADDED
}

model Settings {
  id              String   @id @default("default")
  warmupEnabled   Boolean  @default(true)
  warmupStartDate DateTime @default(now())
  apiKey          String?  // hashed API key
  apiKeyHint      String?  // last 4 chars for display
  updatedAt       DateTime @updatedAt
}

model EmailLog {
  id        String   @id @default(cuid())
  leadId    String
  subject   String
  sentAt    DateTime @default(now())

  @@index([sentAt])
}

model SignupForm {
  id           String   @id @default(cuid())
  name         String
  sequenceId   String?
  sequence     Sequence? @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  segmentId    String?
  segment      Segment?  @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  buttonText   String   @default("Anmelden")
  successMessage String @default("Danke für deine Anmeldung!")
  submissions  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Segment {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?  // Für UI-Badge (z.B. "#3b82f6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads       LeadSegment[]
  forms       SignupForm[]
}

model LeadSegment {
  id        String   @id @default(cuid())
  leadId    String
  segmentId String
  createdAt DateTime @default(now())

  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  segment   Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([leadId, segmentId])
  @@index([leadId])
  @@index([segmentId])
}

model EmailSettings {
  id              String   @id @default("default")
  // Footer
  footerLogo      String?  // URL zum Logo
  footerText      String?  // z.B. "© 2024 Firma GmbH"
  footerLinks     Json?    // [{ label: "Impressum", url: "..." }]
  companyName     String?
  companyAddress  String?
  // Social Links
  socialLinks     Json?    // { twitter: "...", linkedin: "..." }
  // Styling
  primaryColor    String   @default("#000000")
  // Sender
  senderName      String?
  replyToEmail    String?
  updatedAt       DateTime @updatedAt
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("standard") // standard, marketing, transactional
  thumbnail   String?  // Preview-Bild URL
  content     Json     // TipTap JSON
  subject     String?  // Beispiel-Betreff
  isBuiltIn   Boolean  @default(false) // Vordefinierte Templates
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
